{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ngocnhanvo/beast-arena-actions/tree/main/packages/sprite-foundation/manifest.schema.json",
  "title": "Sprite Foundation v1 layered source contract",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "asset_id", "canvas", "frame_count", "parts", "layer_order", "part_template", "render_template", "topology", "authoring", "motion"],
  "properties": {
    "schema": {"const": "sprite-foundation/1"},
    "project_id": {"type": "string", "minLength": 1},
    "asset_id": {"type": "string", "minLength": 1},
    "canvas": {"type": "array", "prefixItems": [{"type":"integer","minimum":12}, {"type":"integer","minimum":12}], "minItems": 2, "maxItems": 2},
    "frame_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "parts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "layer_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "part_template": {"type": "string", "pattern": "\\{part\\}"},
    "render_template": {"type": "string", "minLength": 1},
    "empty_slots": {"type": "array", "items": {"type": "string"}},
    "empty_slot_template": {"type": "string"},
    "max_body_components": {"type": "integer", "minimum": 1},
    "max_part_components": {"type": "integer", "minimum": 1},
    "anchors_by_frame": {"type": "array", "items": {"type": "object"}},
    "anchor_tolerance_px": {"type": "integer", "minimum": 0, "maximum": 20},
    "topology": {"type": "array", "items": {"type": "object", "required": ["a", "b"], "properties": {
      "a": {"type": "string"}, "b": {"type": "string"},
      "min_overlap_pixels": {"type": "integer", "minimum": 0},
      "contact_gap_px": {"type": "integer", "minimum": 0, "maximum": 10}
    }}},
    "style_review_ratios": {"type": "object"},
    "authoring": {"type": "object", "properties": {
      "source_kind": {"enum": ["procedural", "artist", "auto_inferred", "traced", "licensed"]},
      "owner_review": {"enum": ["REJECTED", "PENDING", "APPROVED"]}
    }},
    "motion": {"type": "object", "required": ["ground_contact_verified", "loop_review_verified"], "properties": {
      "ground_contact_verified": {"type": "boolean"},
      "loop_review_verified": {"type": "boolean"}
    }}
  }
}